<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GeoVial.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GeoVial.Mobile"
    Title="GeoVial.Mobile">

    <TabBar>
        <ShellContent
            Title="Sync"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Captura"
            ContentTemplate="{DataTemplate local:CapturaPage}"
            Route="CapturaPage" />
        <ShellContent
            Title="Revisión"
            ContentTemplate="{DataTemplate local:RevisionPage}"
            Route="RevisionPage" />
        <ShellContent
            Title="Mapa"
            ContentTemplate="{DataTemplate local:MapaPage}"
            Route="MapaPage" />
        <ShellContent
            Title="Bandeja"
            ContentTemplate="{DataTemplate local:BandejaPage}"
            Route="BandejaPage" />
    </TabBar>

</Shell>
