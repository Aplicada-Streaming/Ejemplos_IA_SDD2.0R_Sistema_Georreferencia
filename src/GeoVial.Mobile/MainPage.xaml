<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GeoVial.Mobile.MainPage"
             Title="GeoVial — Captura de campo">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <!-- UX: el título usaba el estilo Headline (gigante) y empujaba el selector de relevamiento y el
                 estado de sincronización fuera del viewport inicial. Se reduce para priorizar las acciones. -->
            <Label Text="GeoVial — Captura de campo"
                   FontSize="22"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Recolección sin conexión y sincronización automática (EP-04)." />

            <!-- S55: indicar con qué usuario está abierta la sesión. -->
            <Label x:Name="UsuarioLbl"
                   Text="Sesión iniciada"
                   FontAttributes="Italic"
                   TextColor="#1565c0" />

            <!-- F-M-04/05: elegir el relevamiento a trabajar (los asignados van primero, marcados). -->
            <Label Text="Relevamiento activo" FontAttributes="Bold" />
            <Picker x:Name="RelevamientoPicker"
                    Title="Elegí un relevamiento"
                    SelectedIndexChanged="OnRelevamientoSeleccionado" />

            <Label x:Name="PendientesLbl"
                   Text="Pendientes en cola: 0"
                   FontAttributes="Bold"
                   FontSize="18" />

            <!-- Indicador de estado de sincronización (S48): al día / pendiente / sincronizando / sin conexión / error. -->
            <Label x:Name="SyncEstadoLbl"
                   Text="Todo sincronizado"
                   FontSize="14" />

            <!-- Aviso de conflictos detectados al sincronizar (S49): visible sólo si hay conflictos. -->
            <Label x:Name="AvisoConflictosLbl"
                   IsVisible="False"
                   TextColor="#b00020"
                   FontAttributes="Bold"
                   FontSize="14" />

            <Button x:Name="CapturarBtn"
                    Text="Capturar observación (offline)"
                    Clicked="OnCapturar"
                    HorizontalOptions="Fill" />

            <Button x:Name="SyncBtn"
                    Text="Sincronizar con el backend"
                    Clicked="OnSincronizar"
                    HorizontalOptions="Fill" />

            <Border Padding="12" Stroke="#cccccc" StrokeThickness="1">
                <Label x:Name="EstadoLbl"
                       Text="Listo. Capturá observaciones sin conexión y luego sincronizá."
                       LineBreakMode="WordWrap" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
