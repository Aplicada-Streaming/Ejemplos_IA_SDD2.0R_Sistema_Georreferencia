<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GeoVial.Mobile.MainPage"
             Title="GeoVial — Captura de campo">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="GeoVial — Captura de campo"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Recolección sin conexión y sincronización automática (EP-04)." />

            <!-- F-M-04/05: elegir el relevamiento a trabajar (los asignados van primero, marcados). -->
            <Label Text="Relevamiento activo" FontAttributes="Bold" />
            <Picker x:Name="RelevamientoPicker"
                    Title="Elegí un relevamiento"
                    SelectedIndexChanged="OnRelevamientoSeleccionado" />

            <Label x:Name="PendientesLbl"
                   Text="Pendientes en cola: 0"
                   FontAttributes="Bold"
                   FontSize="18" />

            <Button x:Name="CapturarBtn"
                    Text="Capturar observación (offline)"
                    Clicked="OnCapturar"
                    HorizontalOptions="Fill" />

            <Button x:Name="SyncBtn"
                    Text="Sincronizar con el backend"
                    Clicked="OnSincronizar"
                    HorizontalOptions="Fill" />

            <Border Padding="12" Stroke="#cccccc" StrokeThickness="1">
                <Label x:Name="EstadoLbl"
                       Text="Listo. Capturá observaciones sin conexión y luego sincronizá."
                       LineBreakMode="WordWrap" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
