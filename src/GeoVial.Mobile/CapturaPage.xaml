<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GeoVial.Mobile"
             x:Class="GeoVial.Mobile.CapturaPage"
             Title="Captura de campo">

    <!-- H-05: cinta persistente; H-01/H-03: la captura ocurre SOBRE el mapa (pines del relevamiento + posición del agente). -->
    <Grid RowDefinitions="Auto,Auto,*">
        <local:CintaConexionView x:Name="Cinta" Grid.Row="0" />
        <WebView x:Name="MapaWeb" Grid.Row="1" HeightRequest="240" />
        <ScrollView Grid.Row="2">
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="Capturar observación" FontSize="22" FontAttributes="Bold" />
            <Label Text="Elegí o tomá una foto: la coordenada se deriva de sus metadatos EXIF (RN-03). Si no trae ubicación, la observación va a la bandeja y podés ubicarla a mano."
                   FontSize="13" TextColor="#666666" />

            <!-- H-11 (auditoría UX): "Tomar foto" es la acción primaria de campo (disparador) — objetivo grande y
                 destacado (Ley de Fitts); "Elegir foto" (galería) queda como acción secundaria. -->
            <Button x:Name="TomarBtn" Text="📷 Tomar foto" Clicked="OnTomarFoto"
                    FontSize="20" FontAttributes="Bold" HeightRequest="64" />
            <Button x:Name="ElegirBtn" Text="Elegir foto de la galería" Clicked="OnElegirFoto"
                    FontSize="14" BackgroundColor="Transparent" TextColor="#1565c0" />

            <Border Padding="12" Stroke="#cccccc" StrokeThickness="1" Margin="0,8,0,0">
                <Label x:Name="GeorrefLbl" Text="Sin foto seleccionada." />
            </Border>

            <!-- UX: el texto largo se truncaba ("…y subir la"); se acorta y el detalle va en el estado de abajo. -->
            <Button x:Name="EnviarBtn" Text="Enviar captura" Clicked="OnEnviar" IsEnabled="False" />

            <Border Padding="12" Stroke="#cccccc" StrokeThickness="1">
                <Label x:Name="EstadoLbl" Text="" />
            </Border>

            <!-- Ubicación manual: aparece solo si la observación quedó sin georreferenciar (US-13, CU-05). -->
            <VerticalStackLayout x:Name="UbicacionPanel" IsVisible="False" Spacing="8" Margin="0,8,0,0">
                <Label Text="Ubicar el punto" FontAttributes="Bold" />
                <!-- S56: lo más cómodo es elegir el punto sobre el mapa (moviendo el marcador). -->
                <Button Text="📍 Elegí el punto en el mapa" Clicked="OnElegirEnMapa" BackgroundColor="#1565c0" TextColor="White" />
                <Label Text="o cargá las coordenadas a mano:" FontSize="12" TextColor="#666666" />
                <Entry x:Name="LatEntry" Placeholder="Latitud (-90 a 90)" Keyboard="Numeric" />
                <Entry x:Name="LonEntry" Placeholder="Longitud (-180 a 180)" Keyboard="Numeric" />
                <Button Text="Ubicar el punto" Clicked="OnUbicar" />
            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
