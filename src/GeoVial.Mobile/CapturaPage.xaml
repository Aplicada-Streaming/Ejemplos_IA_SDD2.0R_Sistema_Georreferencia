<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GeoVial.Mobile.CapturaPage"
             Title="Captura de campo">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="Capturar observación" FontSize="22" FontAttributes="Bold" />
            <Label Text="Elegí o tomá una foto: la coordenada se deriva de sus metadatos EXIF (RN-03). Si no trae ubicación, la observación va a la bandeja sin georreferenciar."
                   FontSize="13" TextColor="#666666" />

            <Button x:Name="ElegirBtn" Text="Elegir foto" Clicked="OnElegirFoto" />
            <Button x:Name="TomarBtn" Text="Tomar foto" Clicked="OnTomarFoto" />

            <Border Padding="12" Stroke="#cccccc" StrokeThickness="1" Margin="0,8,0,0">
                <Label x:Name="GeorrefLbl" Text="Sin foto seleccionada." />
            </Border>

            <Entry x:Name="ComentarioEntry" Placeholder="Comentario (opcional)" />

            <Button x:Name="EnviarBtn" Text="Enviar captura al backend" Clicked="OnEnviar" IsEnabled="False" />

            <Border Padding="12" Stroke="#cccccc" StrokeThickness="1">
                <Label x:Name="EstadoLbl" Text="" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
