<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Empaquetado NuGet de la librería publicable (EP-09, ADR-07; estrategia-versionado §1/§3/§5). -->
    <PackageId>GeoVial.Sync</PackageId>
    <Title>GeoVial.Sync</Title>
    <Description>Librería de sincronización offline/online de GeoVial: cola local de cambios sobre SQLite, motor de sincronización (last-write-wins e idempotencia) y reporte de conflictos, sobre una superficie pública estable versionada con SemVer.</Description>
    <Authors>Equipo GeoVial</Authors>
    <Company>GeoVial</Company>
    <PackageTags>sync;offline;sqlite;geovial;last-write-wins;mobile</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Aplicada-Streaming/Ejemplos_IA_SDD2.0R_Sistema_Georreferencia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Aplicada-Streaming/Ejemplos_IA_SDD2.0R_Sistema_Georreferencia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Versionado automático por MinVer desde los tags Git con prefijo v (no se edita a mano). -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- Release: el .nupkg se produce como parte del build (CI lo genera y una prueba verifica su contenido). -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="MinVer" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
