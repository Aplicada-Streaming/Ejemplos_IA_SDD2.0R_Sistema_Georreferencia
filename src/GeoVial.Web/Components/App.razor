<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GeoVial.Web.styles.css"]" />
    <!-- Leaflet + OpenStreetMap para el mapa interactivo de la revisión (US-21). OSM es libre: sin clave de
         proveedor, sólo requiere la atribución que agrega el tile layer. Leaflet se sirve desde wwwroot
         (vendorizado, Sprint 31): sin dependencia de CDN en runtime. Las teselas siguen viniendo por red de
         OSM; el detalle de offline/caché está en 09_devops/mapa-offline-teselas. -->
    <link rel="stylesheet" href="lib/leaflet/leaflet.css" />
    <script src="lib/leaflet/leaflet.js"></script>
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <!-- Service Worker que cachea las teselas OSM visitadas para verlas sin red (mapa-offline-teselas). -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw-teselas.js')
                .catch(function (e) { console.warn('SW de teselas no registrado:', e); });
        }
    </script>
</body>

</html>
